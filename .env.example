# ── Database ──────────────────────────────────────────────────────────────────
DATABASE__URL=mariadb+pymysql://mariadb:my-secret-pw@gradeflow-mariadb:3306/gradeflow

# ── Valkey ────────────────────────────────────────────────────────────────────
VALKEY__URL=valkey://gradeflow-valkey:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECURITY__JWT_SECRET=change-me-in-prod

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins.
CORS__ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ── Executor ──────────────────────────────────────────────────────────────────
# SYNCHRONOUS | INMEMORY_SUBPROCESS | NOMAD
EXECUTOR__EXECUTOR=NOMAD

# Absolute public URL of this API — required for NOMAD so the engine can POST results back.
EXECUTOR__CALLBACK_BASE_URL=http://gradeflow-backend:8000

# ── Nomad ─────────────────────────────────────────────────────────────────────
EXECUTOR__NOMAD_HOST=host.docker.internal
EXECUTOR__NOMAD_PORT=4646
# EXECUTOR__NOMAD_TOKEN=
# EXECUTOR__NOMAD_NAMESPACE=
# EXECUTOR__NOMAD_DATACENTERS=dc1
# EXECUTOR__NOMAD_CPU=200
# EXECUTOR__NOMAD_MEMORY_MB=512
